# Machine-local settings. This directory (local/) is gitignored.
# Copied here by the first `./bootstrap.sh` run. Sourced by bash.

# --- Identity of this machine ---------------------------------------------
AF_HOSTNAME="agent-host"          # slave: ComputerName/HostName to set
AF_HOST_TAILNET="agent-host"      # master: tailnet name of the host to reach
AF_HOST_USER="agent"              # master: macOS user on the host
AF_HOST_BREW_PREFIX="/opt/homebrew"  # master: Homebrew prefix on the host (af attach calls tmux/mosh-server there)
AF_LID_CLOSED=0                   # slave: 1 = runs with the lid shut; never sleep (pmset disablesleep)

# --- Where things live ----------------------------------------------------
AF_DEVELOPER_DIR="$HOME/Developer"   # projects get cloned under here
AF_WORKTREES_DIR="$HOME/Developer/.worktrees"

# --- Terminal environment: your dotfiles (slave step 25) ------------------
# agentfiles does not manage shell/editor config itself; step 25 clones the
# dotfiles repo, installs its Brewfile.terminal and runs these make targets.
# Empty DOTFILES_REPO = skip.
DOTFILES_REPO="https://github.com/hamsternik/dotfiles.git"
DOTFILES_DIR="$HOME/.dotfiles"
DOTFILES_TARGETS="install-git-conf install-tmux-conf install-nvim-conf install-vim-conf install-shell-conf install-fish-conf install-fish-plugins install-zsh-conf install-ssh-conf"
AF_LOGIN_SHELL=fish               # slave: login shell of this user (empty = leave it alone)

# --- Notifications --------------------------------------------------------
# A command that receives one message as $1. Empty = log only.
# e.g. AF_NOTIFY_CMD="$AF_ROOT/local/notify.sh"   (local/ is git-ignored)
AF_NOTIFY_CMD=""

# --- US egress gateway (slave) --------------------------------------------
AF_US_GATEWAY_ENABLED=1
AF_US_GATEWAY_PROVIDER="mullvad"
AF_US_GATEWAY_COUNTRIES="USA"
AF_US_GATEWAY_CITIES=""           # optional, comma-separated

# Where browsers/jobs reach the US proxy.
#   slave:   http://127.0.0.1:8888 (default when empty)
#   master:  http://agent-host:8888 (the host over Tailscale)
AF_US_PROXY_URL=""

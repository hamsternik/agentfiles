# Machine-local settings. This directory (local/) is gitignored.
# Copied here by the first `./bootstrap.sh` run. Sourced by bash.

# --- Identity of this machine ---------------------------------------------
AF_HOSTNAME="agent-host"          # host: ComputerName/HostName to set
AF_HOST_TAILNET="agent-host"      # cockpit: tailnet name of the host to reach
AF_HOST_USER="agent"              # cockpit: macOS user on the host
AF_LID_CLOSED=0                   # host: 1 = runs with the lid shut; never sleep (pmset disablesleep)

# --- Where things live ----------------------------------------------------
AF_DEVELOPER_DIR="$HOME/Developer"   # projects get cloned under here
AF_WORKTREES_DIR="$HOME/Developer/.worktrees"

# --- Reuse your personal dotfiles (optional) ------------------------------
# agentfiles does not manage shell/editor config itself; it can delegate to
# an existing dotfiles repo and run selected make targets from it.
DOTFILES_REPO=""                  # e.g. https://github.com/<you>/dotfiles.git
DOTFILES_DIR="$HOME/.dotfiles"
DOTFILES_TARGETS=""               # e.g. "install-git-conf install-tmux-conf install-fish-conf"

# --- Notifications --------------------------------------------------------
# A command that receives one message as $1. Empty = log only.
# e.g. AF_NOTIFY_CMD="$HOME/.agentfiles/notify.sh"
AF_NOTIFY_CMD=""

# --- US egress gateway (host) ---------------------------------------------
AF_US_GATEWAY_ENABLED=1
AF_US_GATEWAY_PROVIDER="mullvad"
AF_US_GATEWAY_COUNTRIES="USA"
AF_US_GATEWAY_CITIES=""           # optional, comma-separated

# Where browsers/jobs reach the US proxy.
#   host:    http://127.0.0.1:8888 (default when empty)
#   cockpit: http://agent-host:8888 (the host over Tailscale)
AF_US_PROXY_URL=""

# Dependencies of the agentfiles repo itself (hooks, lint, af).
# Install with: make deps   (= brew bundle --file Brewfile)
# Role-specific packages live in roles/<role>/Brewfile.
brew "gitleaks"     # pre-commit secret scan
brew "shellcheck"   # make lint
brew "yq"           # af projects / af job read YAML manifests
brew "jq"           # af gateway / af sim parse JSON

# Exact versions for the agent toolchain (Strategy A, docs/plans/PLAN-session-2.md).
# Change them on purpose, then run the step (`make slave`) and `af versions`.
# Loaded by af_load_config after limits.env; versions only, never secrets or machine values.
# The "# renovate:" comments are for a later Renovate setup.

# Xcode, installed and selected with xcodes. The build is checked after install.
# renovate: datasource=custom.xcode depName=xcode
AF_XCODE_VERSION=27.1
AF_XCODE_BUILD=27A9275

# xcodes 2.1.0 fixed the Apple developer login; older versions cannot sign in.
# renovate: datasource=github-releases depName=XcodesOrg/xcodes
AF_XCODES_MIN_VERSION=2.1.0

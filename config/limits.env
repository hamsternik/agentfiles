# Default resource limits for an agent host. Sized for 16 GB RAM / 512 GB disk.
# Override per machine in local/limits.env (same variable names).

# Concurrency slots, enforced by `af slot <kind> -- <cmd>`
AF_MAX_XCODEBUILD=1      # Xcode builds/tests at once
AF_MAX_SIMULATOR=2       # booted simulators at once
AF_MAX_BROWSER=2         # headless/headed browser sessions at once
AF_MAX_WORKTREES=6       # agent worktrees alive at once
AF_SLOT_WAIT_SECONDS=3600  # give up waiting for a slot after this long

# Health thresholds, checked by `af health`
AF_DISK_WARN_PCT=80      # notify above this % used
AF_DISK_BLOCK_PCT=90     # refuse new worktrees/builds above this % used
AF_SWAP_WARN_MB=4096     # notify when swap used exceeds this
AF_MEM_FREE_WARN_PCT=15  # notify when system-wide free memory % drops below this

# Cleanup, run by `af cleanup --apply` (scheduled weekly)
AF_DERIVED_DATA_MAX_AGE_DAYS=7
AF_LOG_MAX_AGE_DAYS=14
AF_LOG_MAX_LINES=5000    # trim longer logs to their newest lines (health.log: ~50 days)
AF_DOCKER_PRUNE_UNTIL=168h

# OrbStack Linux VM memory cap, so containers cannot starve Xcode and simulators
AF_ORB_MEMORY_MIB=3072

# US egress gateway (gluetun). Host-side proxy port.
AF_US_PROXY_PORT=8888

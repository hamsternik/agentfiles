#!/usr/bin/env bash
# Secrets in the macOS Keychain: af secret set|get|has|rm <name>
set -euo pipefail
AF_ROOT="${AF_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AF_ROOT
# shellcheck source=../lib/common.sh
. "$AF_ROOT/lib/common.sh"
af_load_config

# Names look like "us-gateway/wireguard-private-key". Values never touch the repo
# or local/. Service name in Keychain: "agentfiles".
require_macos
svc="agentfiles"
name="${2:-}"

# Reads time out: over SSH a locked login keychain can make `security` hang.
# macOS has no `timeout`; perl's alarm survives exec. Without perl: no timeout.
keychain() {
  if have perl; then perl -e 'alarm shift; exec @ARGV' "$AF_KEYCHAIN_TIMEOUT_SECONDS" security "$@"
  else security "$@"; fi
}
hint="Keychain read failed or timed out (${AF_KEYCHAIN_TIMEOUT_SECONDS}s). Over SSH the login keychain may be locked: run 'security unlock-keychain ~/Library/Keychains/login.keychain-db', then retry."
case "${1:-}" in
  set)
    [[ -n "$name" && -t 0 ]] || die "usage (interactive): af secret set <name>"
    # A bare trailing -w makes `security` prompt, so the value never appears in ps.
    security add-generic-password -U -s "$svc" -a "$name" -w
    ok "stored $name"
    ;;
  get) keychain find-generic-password -s "$svc" -a "${name:?name}" -w || die "$hint" ;;
  has)
    rc=0; keychain find-generic-password -s "$svc" -a "${name:?name}" >/dev/null 2>&1 || rc=$?
    (( rc != 142 )) || warn "$hint"     # 142 = killed by the alarm
    exit "$rc"
    ;;
  rm)  security delete-generic-password -s "$svc" -a "${name:?name}" >/dev/null && ok "removed $name" ;;
  *) die "usage: af secret set|get|has|rm <name>" ;;
esac

#!/usr/bin/env bash
# Secrets in the macOS Keychain: af secret set|get|has|rm <name>
set -euo pipefail
AF_ROOT="${AF_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AF_ROOT
# shellcheck source=../lib/common.sh
. "$AF_ROOT/lib/common.sh"
af_load_config

# Names look like "us-gateway/wireguard-private-key". Values never touch the repo
# or local/. Service name in Keychain: "agentfiles".
require_macos
svc="agentfiles"
name="${2:-}"
case "${1:-}" in
  set)
    [[ -n "$name" && -t 0 ]] || die "usage (interactive): af secret set <name>"
    # A bare trailing -w makes `security` prompt, so the value never appears in ps.
    security add-generic-password -U -s "$svc" -a "$name" -w
    ok "stored $name"
    ;;
  get) security find-generic-password -s "$svc" -a "${name:?name}" -w ;;
  has) security find-generic-password -s "$svc" -a "${name:?name}" >/dev/null 2>&1 ;;
  rm)  security delete-generic-password -s "$svc" -a "${name:?name}" >/dev/null && ok "removed $name" ;;
  *) die "usage: af secret set|get|has|rm <name>" ;;
esac

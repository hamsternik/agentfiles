#!/usr/bin/env bash
# Attach to the host from the master: af attach [tmux-session] | af attach --screen
set -euo pipefail
AF_ROOT="${AF_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AF_ROOT
# shellcheck source=../lib/common.sh
. "$AF_ROOT/lib/common.sh"
af_load_config

host="${AF_HOST_TAILNET:?set AF_HOST_TAILNET in local/machine.env}"
if [[ "${1:-}" == --screen ]]; then
  exec open "vnc://$host"
fi
session="${1:-main}"
# `ssh host cmd` runs a non-login, non-interactive shell on the slave: no
# Homebrew on PATH. So call tmux and mosh-server by absolute path.
bin="${AF_HOST_BREW_PREFIX:-/opt/homebrew}/bin"
if have mosh; then
  exec mosh --server="$bin/mosh-server" agent -- "$bin/tmux" new -A -s "$session"
else
  exec ssh -t agent "$bin/tmux" new -A -s "$session"
fi
